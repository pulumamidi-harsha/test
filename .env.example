# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How many published testimonials to show in the Reviews deck
# (admin dashboard can override this when Supabase is connected)
NEXT_PUBLIC_TESTIMONIALS_VISIBLE_COUNT=8

# Homepage Work strip (agr.studio-style horizontal scroller)
# Columns visible at once: 2 | 3 | 4
NEXT_PUBLIC_WORK_COLUMNS=2
# Max projects to show from portfolio
NEXT_PUBLIC_WORK_MAX_PROJECTS=8

# Supabase (Project Settings → API)
# Put these in .env.local (dev) and in your Node host env (e.g. Vercel) for production.
# Do NOT commit real keys. SUPABASE_SERVICE_ROLE_KEY must never be NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Contentful — News space only (Plan B: n8n writes → Delivery API reads at build)
# Delivery token is read-only. Never put Management token in NEXT_PUBLIC_ or client code.
CONTENTFUL_NEWS_SPACE_ID=
CONTENTFUL_NEWS_DELIVERY_TOKEN=
CONTENTFUL_NEWS_ENVIRONMENT=master
# Optional: how many cards per page on /news
NEXT_PUBLIC_NEWS_PER_PAGE=9

# CMS admin (news + testimonials) — Node host only (not Bluehost shared FTP)
# Public URL path (default /admin). Physical routes are /admin; other values rewrite → /admin.
NEXT_PUBLIC_CMS_ADMIN_BASE=/admin
# Management token — server only, used by /api/cms/* proxies (never NEXT_PUBLIC_)
CONTENTFUL_NEWS_MANAGEMENT_TOKEN=
# n8n webhook (Render). Prefer server-only; NEXT_PUBLIC_ accepted as fallback.
N8N_WEBHOOK_URL=
# NEXT_PUBLIC_N8N_WEBHOOK_URL=

# Projects — defaults to News space + content_type `project` when unset
# CONTENTFUL_PROJECTS_SPACE_ID=
# CONTENTFUL_PROJECTS_DELIVERY_TOKEN=
# CONTENTFUL_PROJECTS_ENVIRONMENT=master

# Optional later (multi-space)
# CONTENTFUL_TESTIMONIALS_SPACE_ID=
# CONTENTFUL_TESTIMONIALS_DELIVERY_TOKEN=

# Deploy note: Bluehost shared (FTP static) cannot run Next.js /admin or /cms.
# Use Vercel/Railway/Render/Fly or a VPS with Node. See docs/admin-supabase.md.

# Google Analytics 4 (optional) — Measurement ID from GA Admin → Data streams
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Contact form email (Resend) — Node host only
# https://resend.com → API key + verify sending domain
RESEND_API_KEY=
# Inbox that receives new enquiries
CONTACT_TO_EMAIL=hello@nexorasites.com
# From address (must be on a verified Resend domain)
CONTACT_FROM_EMAIL="Nexora Sites <hello@nexorasites.com>"
# Logo in HTML emails: svg (inline, edit src/lib/email/logo.ts) | image
EMAIL_LOGO_MODE=svg
# When EMAIL_LOGO_MODE=image — absolute URL (or leave blank to use SITE_URL/brand/logo-white.svg)
# EMAIL_LOGO_IMAGE_URL=https://nexorasites.com/brand/logo-white.svg

# Optional future integrations
# OPENAI_API_KEY=
